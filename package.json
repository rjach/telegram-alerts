{
  "name": "@rojan-labs/telegram-alerts",
  "version": "0.1.0",
  "description": "Telegram alerts for SaaS founders: one message on every signup, subscription, cancellation or payment. Zero dependencies, never throws.",
  "keywords": [
    "telegram",
    "alerts",
    "notifications",
    "saas",
    "signup",
    "subscription",
    "stripe",
    "freemius",
    "auth.js",
    "founder"
  ],
  "license": "MIT",
  "author": "Rojan Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rojan-labs/telegram-alerts.git"
  },
  "homepage": "https://github.com/rojan-labs/telegram-alerts#readme",
  "bugs": "https://github.com/rojan-labs/telegram-alerts/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "telegram-alerts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "release": "npm version",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "eslint": "^9.36.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4",
    "prettier": "^3.6.2"
  }
}
